<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex public/index.php

    # 1. Lindungi berkas sensitif dari akses publik langsung
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml) - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage/logs|tests|vendor) - [F,L]

    # 2. Arahkan halaman utama (/) langsung ke public/index.php
    RewriteRule ^$ public/index.php [L]

    # 3. Jika mengakses file aset (css, js, gambar, apk) yang ada di dalam public/, tampilkan filenya
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 4. Semua URL lainnya arahkan ke public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

